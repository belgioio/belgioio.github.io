<div class="col">
  <div class="card h-100 text-center border-0 person-card">
    {% assign img_path = person.img | prepend: 'assets/img/people/' | relative_url %}
    <img
      src="{{ img_path }}"
      class="card-img-top"
      alt="{{ person.name }}"
      loading="lazy"
      style="object-fit: cover; width: 100%; aspect-ratio: 1 / 1;"
    >
    <div class="card-body px-0">
      <h5 class="card-title mb-1">
        {% if person.website %}
          <a href="{{ person.website }}" target="_blank" rel="noopener">{{ person.name }}</a>
        {% else %}
          {{ person.name }}
        {% endif %}
      </h5>
      {% if person.note %}
        <p class="text-muted" style="font-size: 0.9em;">({{ person.note }})</p>
      {% endif %}
    </div>
  </div>
</div>
